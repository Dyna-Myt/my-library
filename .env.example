# ------------------------------------------------------------------ #
#  My Library — environment                                          #
#  Copy to .env.local (local) or paste into Vercel → Project → Env.   #
# ------------------------------------------------------------------ #

# Public site URL, used for metadata, OG tags, robots and the sitemap.
# Local: http://localhost:3000
# Vercel: https://your-project.vercel.app (or your custom domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------ #
#  Supabase (optional)                                               #
#  Without these the app runs in demo mode with local seed data.     #
#  Project Settings → API → Project URL + anon/publishable key.       #
# ------------------------------------------------------------------ #
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Passcode used by /admin only while Supabase is NOT configured.
# Ignored once Supabase env vars are present.
NEXT_PUBLIC_DEMO_PASSCODE=library
